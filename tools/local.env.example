# Réglages propres à l'installation : copier dans secrets/local.env (non versionné) et remplir.
# Adresse IP de la TV Samsung sur le réseau local (Paramètres > Général > Réseau > État du réseau)
TV_IP=192.168.1.XX
# DUID de la TV, pour les certificats Samsung (sdb shell 0 getduid, une fois la TV connectée en mode développeur)
TV_DUID=XXXXXXXXXXXXX
